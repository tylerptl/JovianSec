---
import '@fontsource-variable/inter';
import '../styles/global.css';
import { site } from '../data/site';

interface Props {
  title?: string;
  description?: string;
}

const {
  title = `${site.name} — ${site.tagline}`,
  description = site.description,
} = Astro.props;

const canonical = new URL(Astro.url.pathname, Astro.site ?? 'https://joviansec.com');
---

<!doctype html>
<html lang="en" data-theme="dark">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical.href} />
    <meta property="og:type" content="website" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical.href} />
    <meta name="twitter:card" content="summary_large_image" />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    {/* Resolve the theme before first paint so the page never flashes the wrong ground. */}
    <script is:inline>
      (function () {
        var theme = 'dark';
        try {
          var stored = localStorage.getItem('jv-theme');
          if (stored === 'light' || stored === 'dark') {
            theme = stored;
          } else if (window.matchMedia('(prefers-color-scheme: light)').matches) {
            theme = 'light';
          }
        } catch (e) {
          /* storage blocked — fall back to dark */
        }
        document.documentElement.dataset.theme = theme;
      })();
    </script>
  </head>
  <body>
    {/* The shell every page shares: skip link, then the canvas. */}
    <a class="skip" href="#main">Skip to content</a>

    <div class="page">
      <slot />
    </div>
    <script is:inline>
      // Arm the cross-fade only after the first frame, so loading a page in the
      // light theme doesn't animate up from dark.
      requestAnimationFrame(function () {
        document.documentElement.classList.add('jv-ready');
      });
    </script>
  </body>
</html>

<style>
  /* The canvas fills the viewport rather than sitting in a fixed 1280px column:
     content stays flush-left against the (now fluid) gutter and the whitespace
     is still carried on the right. --page-max only engages past 2560px, where
     the fluid scale has already topped out and more width would just stretch
     the hairline grids. */
  .page {
    width: 100%;
    max-width: var(--page-max);
    margin: 0 auto;
    min-height: 100vh;
    min-height: 100dvh;
  }

  .skip {
    position: absolute;
    left: -9999px;
    top: 0;
    z-index: 10;
    padding: 10px 16px;
    font-size: var(--fs-lg);
    color: var(--jv-accent);
    background: var(--jv-surface);
    border: 1px solid var(--jv-accent);
    border-radius: var(--radius-md);
    text-decoration: none;
  }

  .skip:focus {
    left: var(--gutter);
    top: 12px;
  }
</style>
