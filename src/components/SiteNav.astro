---
import LogoMark from './LogoMark.astro';
import ThemeToggle from './ThemeToggle.astro';
import { navLinks } from '../data/site';
---

<header class="nav">
  <a class="brand" href="/">
    <LogoMark size={30} />
    <span class="wordmark">Jovian<span class="wordmark-sub"> Security</span></span>
  </a>

  <nav class="links" aria-label="Primary">
    {navLinks.map((link) => <a href={link.href}>{link.label}</a>)}
  </nav>

  <ThemeToggle />

  <a class="btn btn-primary nav-cta" href="#contact">Request a scope call</a>
</header>

<style>
  .nav {
    display: flex;
    align-items: center;
    gap: 28px;
    padding: 20px var(--gutter);
  }

  .brand {
    display: flex;
    align-items: center;
    gap: 11px;
    margin-right: auto;
    color: inherit;
    text-decoration: none;
  }

  .wordmark {
    font-family: var(--font-heading);
    font-weight: 500;
    font-size: 17px;
    letter-spacing: -0.01em;
  }

  .wordmark-sub {
    opacity: 0.5;
  }

  .links {
    display: flex;
    align-items: center;
    gap: 28px;
  }

  .links a {
    color: inherit;
    text-decoration: none;
    font-size: 14px;
    opacity: 0.7;
  }

  .links a:hover {
    opacity: 1;
  }

  .nav-cta {
    font-size: 13px;
    padding: 7px 13px;
  }

  /* Un-designed fallback — see global.css. No mobile menu was designed, so the
     bar wraps to a second row rather than hiding the links behind a control
     that has no visual spec. */
  @media (max-width: 1023px) {
    .nav {
      flex-wrap: wrap;
      gap: 16px 20px;
    }

    .links {
      order: 3;
      flex-basis: 100%;
      flex-wrap: wrap;
      gap: 20px;
    }
  }
</style>
