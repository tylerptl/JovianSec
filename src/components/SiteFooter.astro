---
import { footerLinks, site } from '../data/site';

const year = new Date().getFullYear();
---

<footer class="footer">
  <span class="copyright">© {year} {site.name} · {site.domain}</span>
  {footerLinks.map((link) => <a href={link.href}>{link.label}</a>)}
</footer>

<style>
  .footer {
    display: flex;
    align-items: center;
    gap: 24px;
    padding: 22px var(--gutter) 34px;
    border-top: 1px solid var(--jv-divider);
    font-size: 12px;
    opacity: 0.5;
  }

  .copyright {
    margin-right: auto;
  }

  .footer a {
    color: inherit;
    text-decoration: none;
  }

  .footer a:hover {
    color: var(--jv-accent);
  }

  /* Un-designed fallback — see global.css. */
  @media (max-width: 639px) {
    .footer {
      flex-wrap: wrap;
      gap: 10px 20px;
    }

    .copyright {
      flex-basis: 100%;
      margin-right: 0;
    }
  }
</style>
