---
import { footerLinks, site } from '../data/site';

const year = new Date().getFullYear();
---

<footer class="footer">
  <span class="copyright">© {year} {site.name} · {site.domain}</span>
  {footerLinks.map((link) => <a href={link.href}>{link.label}</a>)}
</footer>

<style>
  .footer {
    display: flex;
    align-items: center;
    /* 24px / 22px / 34px @ 1280 */
    gap: clamp(18px, 1.875vw, 36px);
    padding: clamp(18px, 1.71875vw, 34px) var(--gutter) clamp(28px, 2.65625vw, 50px);
    border-top: 1px solid var(--jv-divider);
    font-size: var(--fs-sm);
    opacity: 0.5;
  }

  .copyright {
    margin-right: auto;
  }

  .footer a {
    color: inherit;
    text-decoration: none;
  }

  .footer a:hover {
    color: var(--jv-accent);
  }

  /* Un-designed fallback — see global.css. */
  @media (max-width: 639px) {
    .footer {
      flex-wrap: wrap;
      gap: 10px 20px;
    }

    .copyright {
      flex-basis: 100%;
      margin-right: 0;
    }
  }
</style>
