---
/**
 * The reduced planet used as a bleed graphic behind the closing CTA: two orbits
 * rotated +14° and the disc outline only, no banding.
 */
interface Props {
  size?: number;
  class?: string;
}

const { size = 420, class: className } = Astro.props;
---

<svg
  width={size}
  height={size}
  viewBox="0 0 400 400"
  fill="none"
  class={className}
  aria-hidden="true"
  focusable="false"
>
  <ellipse
    cx="200"
    cy="200"
    rx="188"
    ry="68"
    class="s-ink"
    stroke-width=".8"
    opacity=".3"
    transform="rotate(14 200 200)"></ellipse>
  <ellipse
    cx="200"
    cy="200"
    rx="150"
    ry="42"
    class="s-ink"
    stroke-width=".8"
    opacity=".2"
    transform="rotate(14 200 200)"></ellipse>
  <circle cx="200" cy="200" r="78" class="f-bg s-accent" stroke-width=".9" opacity=".45"></circle>
</svg>
