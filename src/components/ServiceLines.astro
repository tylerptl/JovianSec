---
import { serviceLines } from '../data/site';
---

<section class="lines">
  <div class="layout">
    <div class="intro">
      <h2>The four service lines</h2>
      <p>
        Each line is staffed by dedicated operators. Scoped by system, priced by
        outcome.
      </p>
    </div>

    <div class="rows">
      {
        serviceLines.map((line) => (
          <a class="row" href={`/services/${line.slug}`}>
            <div class="moon">
              <span class={`dot dot-${line.dot}`} aria-hidden="true" />
              <h3>{line.moon}</h3>
            </div>
            <div>
              <p class="title">{line.title}</p>
              <p class="desc">{line.description}</p>
            </div>
            <p class="duration">{line.duration}</p>
          </a>
        ))
      }
    </div>
  </div>
</section>

<style>
  .lines {
    /* 88px / 76px @ 1280 */
    padding: clamp(64px, 6.875vw, 132px) var(--gutter) clamp(56px, 5.9375vw, 116px);
    border-top: 1px solid var(--jv-divider);
  }

  /* The intro column and the row's name/duration columns were fixed px on the
     canvas; as fluid tracks they hold the same proportion of the page, so the
     row's three columns stay in the ratio the design draws them in. */
  .layout {
    display: grid;
    grid-template-columns: clamp(240px, 23.4375vw, 440px) 1fr; /* 300px @ 1280 */
    gap: clamp(40px, 4.375vw, 88px); /* 56px @ 1280 */
    align-items: start;
  }

  h2 {
    font-size: var(--fs-h2);
    letter-spacing: -0.02em;
    margin: 0 0 12px;
  }

  .intro p {
    font-size: var(--fs-lg);
    opacity: 0.62;
  }

  .row {
    display: grid;
    /* 170px / 120px @ 1280 */
    grid-template-columns: clamp(150px, 13.28125vw, 250px) 1fr clamp(110px, 9.375vw, 176px);
    gap: clamp(20px, 1.875vw, 36px); /* 24px @ 1280 */
    align-items: baseline;
    padding: clamp(18px, 1.71875vw, 34px) 0; /* 22px @ 1280 */
    border-top: 1px solid var(--jv-divider);
  }

  /* Only the last row closes the stack. */
  .row:last-child {
    border-bottom: 1px solid var(--jv-divider);
  }

  /* Each row is the link to its line's page. The design is unchanged at rest —
     the affordance is the hover, so the band still reads as a list, not a
     stack of buttons. */
  .row {
    color: inherit;
    text-decoration: none;
  }

  .row:hover .title,
  .row:hover .moon h3 {
    color: var(--jv-accent);
  }

  .moon {
    display: flex;
    align-items: center;
    gap: 10px;
  }

  /* Set flush with the body leading — the moon name sits on a row baseline,
     not in a heading block. */
  .moon h3 {
    font-size: var(--fs-3xl);
    line-height: 1.55;
    letter-spacing: normal;
  }

  .dot {
    width: 8px;
    height: 8px;
    border-radius: 50%;
  }
  .dot-accent {
    background: var(--jv-accent);
  }
  .dot-rust {
    background: var(--jv-rust);
  }
  .dot-rust-dim {
    background: var(--jv-rust-dim);
  }
  .dot-accent-dim {
    background: var(--jv-accent-dim);
  }

  .title {
    font-size: var(--fs-xl);
    margin-bottom: 5px;
  }

  .desc {
    font-size: var(--fs-md);
    opacity: 0.6;
  }

  .duration {
    font-size: var(--fs-sm);
    opacity: 0.5;
    text-align: right;
  }

  /* Un-designed fallback — see global.css. */
  @media (max-width: 1023px) {
    .lines {
      padding-top: 64px;
      padding-bottom: 56px;
    }

    .layout {
      grid-template-columns: 1fr;
      gap: 32px;
    }

    h2 {
      font-size: 28px;
    }
  }

  @media (max-width: 639px) {
    .row {
      grid-template-columns: 1fr;
      gap: 10px;
    }

    .duration {
      text-align: left;
    }
  }
</style>
