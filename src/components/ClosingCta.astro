---
import OrbitGlyph from './OrbitGlyph.astro';
---

<section id="contact" class="cta">
  <div class="glyph"><OrbitGlyph size={420} /></div>

  <div class="inner">
    <div>
      <h2>Tell us what you are shipping. We will tell you how it breaks.</h2>
      <p class="sub">
        Scope calls are 30 minutes with the operator who would run the test, not a salesperson.
      </p>
    </div>

    <div
      class="capture"
      data-capture
      data-confirm-message="Booked — check your inbox for the calendar link."
    >
      <form class="row" data-lead-form novalidate>
        <label class="sr-only" for="cta-email">Work email</label>
        <input
          class="input"
          id="cta-email"
          name="email"
          type="email"
          inputmode="email"
          autocomplete="email"
          placeholder="you@company.com"
          required
        />
        <button class="btn btn-primary submit" type="submit">Book the call</button>
      </form>

      {/* Both stay in the DOM so screen readers announce them when filled. */}
      <p class="confirm" role="status" aria-live="polite" data-confirm></p>
      <p class="status" role="status" aria-live="polite" data-status></p>
    </div>
  </div>
</section>

<style>
  .cta {
    position: relative;
    /* 84px / 88px @ 1280 */
    padding: clamp(64px, 6.5625vw, 126px) var(--gutter) clamp(64px, 6.875vw, 132px);
    /* One field height for the input, the button and the confirmation line, so
       the row can grow with the viewport without the block ever jumping. */
    --field-h: clamp(42px, 3.28125vw, 52px); /* 42px @ 1280 */
    overflow: hidden;
  }

  /* Bled off the lower left at half strength. Offsets are fractions of the
     glyph so the bleed holds its composition as the graphic scales. */
  .glyph {
    position: absolute;
    --glyph-size: clamp(320px, 32.8125vw, 640px); /* 420px @ 1280 */
    left: calc(var(--glyph-size) * -0.357);
    bottom: calc(var(--glyph-size) * -0.5);
    opacity: 0.5;
    line-height: 0;
    pointer-events: none;
  }

  .glyph :global(svg) {
    width: var(--glyph-size);
    height: auto;
  }

  .inner {
    position: relative;
    display: flex;
    align-items: flex-end;
    justify-content: space-between;
    gap: clamp(32px, 3.75vw, 72px); /* 48px @ 1280 */
  }

  h2 {
    font-size: var(--fs-h2-lg);
    letter-spacing: -0.025em;
    margin: 0 0 12px;
    max-width: clamp(400px, 40.625vw, 720px); /* 520px @ 1280 */
    text-wrap: balance;
  }

  .sub {
    font-size: var(--fs-xl);
    opacity: 0.65;
    max-width: clamp(340px, 34.375vw, 600px); /* 440px @ 1280 */
  }

  .capture {
    position: relative;
    flex: none;
  }

  .row {
    display: flex;
    gap: 10px;
    align-items: center;
  }

  /* An author `display` beats the UA's [hidden] rule, so restate it. */
  .row[hidden] {
    display: none;
  }

  .input {
    width: clamp(240px, 18.75vw, 340px); /* 240px @ 1280 */
    height: var(--field-h);
    padding: 0 12px;
    font: inherit;
    font-size: var(--fs-lg);
    color: var(--jv-ink);
    background: var(--jv-surface);
    border: 1px solid var(--jv-border);
    border-radius: var(--radius-md);
    caret-color: var(--jv-accent);
  }

  .input::placeholder {
    color: var(--jv-ink);
    opacity: 0.45;
  }

  .input[aria-invalid='true'] {
    border-color: var(--jv-accent);
  }

  .submit {
    height: var(--field-h);
    padding: 0 clamp(18px, 1.40625vw, 26px);
    font-size: var(--fs-lg);
  }

  /* Same height as the row it replaces, so the block never jumps. */
  .confirm {
    display: flex;
    align-items: center;
    height: var(--field-h);
    font-size: var(--fs-lg);
    color: var(--jv-accent);
  }

  .confirm:empty {
    display: none;
  }

  /* Errors hang below the row rather than pushing it up. */
  .status {
    position: absolute;
    top: calc(100% + 8px);
    right: 0;
    margin: 0;
    font-size: var(--fs-md);
    color: var(--jv-accent);
  }

  .status:empty {
    display: none;
  }

  /* Un-designed fallback — see global.css. */
  @media (max-width: 1023px) {
    .cta {
      padding-top: 64px;
      padding-bottom: 64px;
    }

    .inner {
      flex-direction: column;
      align-items: flex-start;
      gap: 32px;
    }

    h2 {
      font-size: 32px;
    }

    /* Errors can push the footer down here rather than overlapping it. */
    .status {
      position: static;
      margin-top: 8px;
    }
  }

  @media (max-width: 639px) {
    h2 {
      font-size: 26px;
    }

    .capture,
    .row {
      width: 100%;
    }

    .input {
      width: auto;
      flex: 1;
      min-width: 0;
    }
  }
</style>

<script>
  const EMAIL = /^[^\s@]+@[^\s@]+\.[^\s@]{2,}$/;
  const endpoint = import.meta.env.PUBLIC_JV_LEAD_ENDPOINT;

  document.querySelectorAll<HTMLElement>('[data-capture]').forEach((capture) => {
    const form = capture.querySelector<HTMLFormElement>('[data-lead-form]');
    const input = capture.querySelector<HTMLInputElement>('input[name="email"]');
    const submit = capture.querySelector<HTMLButtonElement>('button[type="submit"]');
    const status = capture.querySelector<HTMLElement>('[data-status]');
    const confirm = capture.querySelector<HTMLElement>('[data-confirm]');
    if (!form || !input || !submit || !status || !confirm) return;

    const setError = (message: string) => {
      status.textContent = message;
      input.setAttribute('aria-invalid', 'true');
    };

    const clearError = () => {
      status.textContent = '';
      input.removeAttribute('aria-invalid');
    };

    input.addEventListener('input', clearError);

    form.addEventListener('submit', async (event) => {
      event.preventDefault();
      const email = input.value.trim();

      if (!EMAIL.test(email)) {
        setError('Enter a valid email address.');
        input.focus();
        return;
      }

      clearError();
      submit.disabled = true;
      submit.textContent = 'Booking…';

      try {
        if (endpoint) {
          const response = await fetch(endpoint, {
            method: 'POST',
            headers: { 'Content-Type': 'application/json' },
            body: JSON.stringify({ email, source: 'homepage-cta' }),
          });
          if (!response.ok) throw new Error(`Lead endpoint returned ${response.status}`);
        } else {
          // No CRM wired up yet — see PUBLIC_JV_LEAD_ENDPOINT in README.md.
          console.warn('PUBLIC_JV_LEAD_ENDPOINT is not set; the submission was not sent anywhere.');
        }

        form.hidden = true;
        confirm.textContent = capture.dataset.confirmMessage ?? 'Booked — we will be in touch.';
      } catch (error) {
        console.error(error);
        setError('That did not go through. Email hello@joviansec.com and we will book it manually.');
        submit.disabled = false;
        submit.textContent = 'Book the call';
      }
    });
  });
</script>
