---
import JupiterPlanet from './JupiterPlanet.astro';
---

<section class="hero">
  <div class="planet"><JupiterPlanet size={760} /></div>

  <div class="copy">
    <p class="eyebrow kicker">
      <span class="eyebrow-rule" aria-hidden="true"></span>Offensive security &amp; security engineering
    </p>

    <h1>Security grounded in operational reality.</h1>

    <p class="lede">
      From penetration testing and adversary emulation to security engineering, all work is delivered directly by our operators. We replace generic compliance checklists with integrated, context-aware remediation that secures production environments.
    </p>

    <div class="actions">
      <a class="btn btn-primary" href="#contact">Request a scope call</a>
      <a class="btn btn-secondary" href="#research">Read a sample report</a>
    </div>
  </div>
</section>

<style>
  .hero {
    position: relative;
    /* 104px / 86px @ 1280 */
    padding: clamp(76px, 8.125vw, 156px) var(--gutter) clamp(64px, 6.71875vw, 128px);
    overflow: hidden;
  }

  /* The planet is sized in CSS rather than by the component's width/height
     attributes so it can ride the viewport, and both offsets are expressed as
     fractions of the disc — the bleed off the top-right corner stays the same
     composition at every width instead of drifting as the graphic grows. */
  .planet {
    position: absolute;
    --planet-size: clamp(560px, 59.375vw, 1180px); /* 760px @ 1280 */
    right: calc(var(--planet-size) * -0.197);
    top: calc(var(--planet-size) * -0.184);
    line-height: 0;
    pointer-events: none;
  }

  .planet :global(svg) {
    width: var(--planet-size);
    height: auto;
  }

  .copy {
    position: relative;
    max-width: clamp(480px, 50vw, 920px); /* 640px @ 1280 */
  }

  .eyebrow {
    display: flex;
    align-items: center;
    gap: 10px;
    margin-bottom: clamp(22px, 2.34375vw, 44px); /* 30px @ 1280 */
  }

  .eyebrow-rule {
    width: 26px;
    height: 1px;
    background: var(--jv-accent);
  }

  h1 {
    font-size: var(--fs-display);
    line-height: 1.03;
    letter-spacing: -0.03em;
    margin: 0 0 clamp(18px, 1.875vw, 36px); /* 24px @ 1280 */
    text-wrap: balance;
  }

  .lede {
    font-size: var(--fs-2xl);
    line-height: 1.6;
    opacity: 0.7;
    max-width: clamp(400px, 39.0625vw, 700px); /* 500px @ 1280 */
    margin: 0 0 clamp(28px, 2.8125vw, 54px); /* 36px @ 1280 */
  }

  .actions {
    display: flex;
    gap: 12px;
  }

  .actions .btn {
    font-size: var(--fs-lg);
    padding: clamp(11px, 0.859375vw, 15px) clamp(19px, 1.484375vw, 27px);
  }

  /* Un-designed fallback — see global.css. Below the canvas the planet stops
     scaling with the viewport and is pinned back and dimmed so the copy stays
     legible over it. */
  @media (max-width: 1023px) {
    .planet {
      --planet-size: 620px;
      right: calc(var(--planet-size) * -0.35);
      opacity: 0.4;
    }
  }

  @media (max-width: 639px) {
    h1 {
      font-size: 34px;
    }

    .lede {
      font-size: 16px;
    }

    .planet {
      --planet-size: 440px;
      opacity: 0.28;
    }

    .actions {
      flex-wrap: wrap;
    }
  }
</style>
