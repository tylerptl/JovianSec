---
/**
 * The Jovian mark: a blocky banded disc with an orbit passing behind it.
 * Geometry is fixed by the handoff — four rects clipped to a r=23 circle,
 * orbit ellipse rotated -18°. Colours come from the palette classes so the
 * mark themes with the page.
 */
interface Props {
  size?: number;
  class?: string;
}

const { size = 30, class: className } = Astro.props;

// clipPath ids are document-global, so each instance gets its own.
const clipId = `mark-clip-${Math.random().toString(36).slice(2, 9)}`;
---

<svg
  width={size}
  height={size}
  viewBox="0 0 100 100"
  fill="none"
  class={className}
  aria-hidden="true"
  focusable="false"
>
  <defs>
    <clipPath id={clipId}><circle cx="50" cy="50" r="23"></circle></clipPath>
  </defs>
  <ellipse
    cx="50"
    cy="50"
    rx="46"
    ry="15"
    class="s-ink"
    stroke-width="2.6"
    opacity=".5"
    transform="rotate(-18 50 50)"></ellipse>
  <g clip-path={`url(#${clipId})`}>
    <rect x="24" y="27" width="52" height="11" class="f-ink"></rect>
    <rect x="24" y="40" width="52" height="8" class="f-accent"></rect>
    <rect x="24" y="50" width="52" height="12" class="f-rust"></rect>
    <rect x="24" y="64" width="52" height="9" class="f-ink"></rect>
  </g>
</svg>

<style>
  svg {
    display: block;
  }
</style>
