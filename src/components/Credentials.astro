---
import { credentials } from '../data/site';
---

<section id="company" class="creds">
  <h2 class="label">Team credentials</h2>
  <ul class="items">
    {credentials.map((item) => <li>{item}</li>)}
  </ul>
</section>

<style>
  .creds {
    display: flex;
    align-items: center;
    /* 40px / 26px @ 1280 */
    gap: clamp(28px, 3.125vw, 60px);
    padding: clamp(22px, 2.03125vw, 40px) var(--gutter);
    border-top: 1px solid var(--jv-divider);
    border-bottom: 1px solid var(--jv-divider);
  }

  .label {
    font-family: var(--font-body);
    font-weight: 400;
    font-size: var(--fs-xs);
    line-height: 1.55;
    letter-spacing: 0.14em;
    text-transform: uppercase;
    opacity: 0.45;
    flex: none;
  }

  .items {
    display: flex;
    gap: clamp(20px, 2.1875vw, 44px); /* 28px @ 1280 */
    flex-wrap: wrap;
    font-size: var(--fs-md);
    opacity: 0.7;
    list-style: none;
    margin: 0;
    padding: 0;
  }

  /* Un-designed fallback — see global.css. */
  @media (max-width: 639px) {
    .creds {
      flex-wrap: wrap;
      gap: 12px 24px;
    }
  }
</style>
