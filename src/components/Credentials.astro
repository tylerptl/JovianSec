---
import { credentials } from '../data/site';
---

<section id="company" class="creds">
  <h2 class="label">Team credentials</h2>
  <ul class="items">
    {credentials.map((item) => <li>{item}</li>)}
  </ul>
</section>

<style>
  .creds {
    display: flex;
    align-items: center;
    gap: 40px;
    padding: 26px var(--gutter);
    border-top: 1px solid var(--jv-divider);
    border-bottom: 1px solid var(--jv-divider);
  }

  .label {
    font-family: var(--font-body);
    font-weight: 400;
    font-size: 11px;
    line-height: 1.55;
    letter-spacing: 0.14em;
    text-transform: uppercase;
    opacity: 0.45;
    flex: none;
  }

  .items {
    display: flex;
    gap: 28px;
    flex-wrap: wrap;
    font-size: 13px;
    opacity: 0.7;
    list-style: none;
    margin: 0;
    padding: 0;
  }

  /* Un-designed fallback — see global.css. */
  @media (max-width: 639px) {
    .creds {
      flex-wrap: wrap;
      gap: 12px 24px;
    }
  }
</style>
