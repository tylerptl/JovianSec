---
import { methodSteps } from '../data/site';
---

<section id="method" class="method">
  <h2>How an engagement runs</h2>
  <p class="intro">
    One operator owns your engagement end to end. You get their name, their calendar and their
    working notes, not a portal.
  </p>

  <ol class="steps">
    {
      methodSteps.map((item) => (
        <li class="step">
          <p class="num">{item.step}</p>
          <h3>{item.title}</h3>
          <p class="body">{item.body}</p>
        </li>
      ))
    }
  </ol>
</section>

<style>
  .method {
    padding: 0 var(--gutter) clamp(64px, 6.5625vw, 126px); /* 84px @ 1280 */
  }

  h2 {
    font-size: var(--fs-h2);
    letter-spacing: -0.02em;
    margin: 0 0 8px;
  }

  .intro {
    font-size: var(--fs-lg);
    opacity: 0.62;
    margin: 0 0 clamp(28px, 3.125vw, 60px); /* 40px @ 1280 */
    max-width: clamp(400px, 40.625vw, 720px); /* 520px @ 1280 */
  }

  /* The 1px gap over a divider-coloured ground is what draws the hairlines
     between cells; each cell repaints the page ground on top. */
  .steps {
    display: grid;
    grid-template-columns: repeat(4, 1fr);
    gap: 1px;
    background: var(--jv-divider);
    list-style: none;
    margin: 0;
    padding: 0;
  }

  .step {
    background: var(--jv-bg);
    /* 26px / 24px / 30px @ 1280 */
    padding: clamp(22px, 2.03125vw, 40px) clamp(20px, 1.875vw, 36px) clamp(24px, 2.34375vw, 46px);
  }

  .num {
    font-size: var(--fs-xs);
    font-family: var(--font-mono);
    color: var(--jv-accent);
    margin-bottom: clamp(12px, 1.09375vw, 20px); /* 14px @ 1280 */
  }

  .step h3 {
    font-size: var(--fs-2xl);
    line-height: 1.55;
    letter-spacing: normal;
    margin-bottom: 7px;
  }

  .body {
    font-size: var(--fs-md);
    opacity: 0.62;
    line-height: 1.5;
  }

  /* Un-designed fallback — see global.css. The 1px-gap hairline grid works at
     any column count, so only the track list changes. */
  @media (max-width: 1023px) {
    .method {
      padding-bottom: 64px;
    }

    h2 {
      font-size: 28px;
    }

    .steps {
      grid-template-columns: repeat(2, 1fr);
    }
  }

  @media (max-width: 639px) {
    .steps {
      grid-template-columns: 1fr;
    }
  }
</style>
