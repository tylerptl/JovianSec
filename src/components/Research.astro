---
import { advisories } from '../data/site';
---

<section id="research" class="research">
  <div class="layout">
    <div>
      <p class="kicker">Research</p>
      <h2>We publish what we find, once it is fixed.</h2>
      <p class="body">
        Disclosure advisories, tooling and detection rules out of live engagements. Coordinated,
        dated, and written for the people who have to patch.
      </p>
      <a class="browse" href="#">Browse the advisories →</a>
    </div>

    <ul class="list">
      {
        advisories.map((advisory) => (
          <li class="row">
            <span class="id">{advisory.id}</span>
            <a class="title" href={advisory.href}>
              {advisory.title}
            </a>
            {advisory.severity ? (
              <span class="pill pill-severity">
                <span class="sr-only">CVSS </span>
                {advisory.severity}
              </span>
            ) : (
              <span class="pill pill-tag">{advisory.tag}</span>
            )}
          </li>
        ))
      }
    </ul>
  </div>
</section>

<style>
  .research {
    padding: 76px var(--gutter) 80px;
  }

  .layout {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 64px;
    align-items: center;
  }

  .kicker {
    margin-bottom: 18px;
  }

  h2 {
    font-size: 28px;
    letter-spacing: -0.02em;
    margin: 0 0 14px;
    max-width: 420px;
  }

  .body {
    font-size: 14px;
    opacity: 0.65;
    max-width: 440px;
    margin: 0 0 22px;
  }

  .browse {
    font-family: var(--font-heading);
    font-weight: var(--font-heading-weight);
    font-size: 14px;
    color: var(--jv-accent);
    text-decoration: none;
  }

  .browse:hover {
    color: var(--jv-zone);
  }

  .list {
    list-style: none;
    margin: 0;
    padding: 0;
  }

  .row {
    display: flex;
    gap: 16px;
    align-items: baseline;
    padding: 14px 0;
    border-bottom: 1px solid var(--jv-divider);
  }

  .id {
    font-size: 11px;
    font-family: var(--font-mono);
    opacity: 0.5;
    width: 104px;
    flex: none;
  }

  .title {
    font-size: 14px;
    flex: 1;
    color: inherit;
    text-decoration: none;
  }

  .title:hover {
    color: var(--jv-accent);
  }

  .pill {
    font-size: 10px;
    border-radius: var(--radius-sm);
    padding: 2px 7px;
    border: 1px solid transparent;
    white-space: nowrap;
  }

  .pill-severity {
    color: var(--jv-accent);
    border-color: var(--jv-accent);
  }

  .pill-tag {
    opacity: 0.6;
    border-color: var(--jv-border);
  }

  /* Un-designed fallback — see global.css. */
  @media (max-width: 1023px) {
    .research {
      padding-top: 56px;
      padding-bottom: 56px;
    }

    .layout {
      grid-template-columns: 1fr;
      gap: 32px;
      align-items: start;
    }
  }

  @media (max-width: 639px) {
    .row {
      flex-wrap: wrap;
      gap: 6px 16px;
    }

    .title {
      flex: 1 1 100%;
      order: 3;
    }
  }
</style>
