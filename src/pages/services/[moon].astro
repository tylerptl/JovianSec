---
import Layout from '../../layouts/Layout.astro';
import SiteNav from '../../components/SiteNav.astro';
import ClosingCta from '../../components/ClosingCta.astro';
import SiteFooter from '../../components/SiteFooter.astro';
import { servicePages } from '../../data/services';
import { site } from '../../data/site';

export function getStaticPaths() {
  return servicePages.map((service) => ({
    params: { moon: service.slug },
    props: { service },
  }));
}

const { service } = Astro.props;

/* The other three lines, in their homepage order, for the band at the foot. */
const others = servicePages.filter((entry) => entry.slug !== service.slug);
---

<Layout
  title={`${service.moon} — ${service.title} · ${site.name}`}
  description={service.meta}
>
  <SiteNav />

  <main id="main">
    <header class="head">
      <p class="eyebrow kicker">
        <span class={`dot dot-${service.dot}`} aria-hidden="true"></span>
        <a class="back" href="/#services">Service lines</a>
        <span class="sep" aria-hidden="true">/</span>
        {service.moon}
      </p>

      <h1>{service.title}</h1>
      <p class="lede">{service.lede}</p>

      <dl class="facts">
        <div>
          <dt>Line</dt>
          <dd>{service.moon}</dd>
        </div>
        <div>
          <dt>Typical engagement</dt>
          <dd>{service.duration}</dd>
        </div>
        <div>
          <dt>Delivered by</dt>
          <dd>Our operators, never subcontracted</dd>
        </div>
      </dl>
    </header>

    <section class="phases" aria-label={`How ${service.moon} runs`}>
      <ol class="steps">
        {
          service.phases.map((phase) => (
            <li class="step">
              <p class="num">{phase.step}</p>
              <h2>{phase.title}</h2>
              <p class="body">{phase.body}</p>
            </li>
          ))
        }
      </ol>
    </section>

    {
      service.details.map((detail) => (
        <section class="detail">
          <div class="detail-head">
            <p class="kicker">{detail.kicker}</p>
            <h2>{detail.heading}</h2>
          </div>
          <div class="prose">
            {detail.body.map((paragraph) => (
              <p>{paragraph}</p>
            ))}
          </div>
        </section>
      ))
    }

    <section class="deliverables">
      <div class="layout">
        <div class="intro">
          <h2>What lands</h2>
          <p>Every engagement closes with the same artifacts, in your hands and in writing.</p>
        </div>

        <ul class="list">
          {
            service.deliverables.map((item) => (
              <li class="row">
                <p class="title">{item.title}</p>
                <p class="desc">{item.body}</p>
              </li>
            ))
          }
        </ul>
      </div>
    </section>

    <nav class="others" aria-label="Other service lines">
      <p class="kicker">The other lines</p>
      <ul>
        {
          others.map((entry) => (
            <li>
              <a href={`/services/${entry.slug}`}>
                <span class={`dot dot-${entry.dot}`} aria-hidden="true" />
                <span class="moon">{entry.moon}</span>
                <span class="title">{entry.title}</span>
              </a>
            </li>
          ))
        }
      </ul>
    </nav>

    <ClosingCta />
  </main>

  <SiteFooter />
</Layout>

<style>
  /* ── Header ─────────────────────────────────────────────────────────────── */
  .head {
    /* 104px / 72px @ 1280 */
    padding: clamp(72px, 8.125vw, 156px) var(--gutter) clamp(52px, 5.625vw, 108px);
  }

  .eyebrow {
    display: flex;
    align-items: center;
    gap: 10px;
    margin-bottom: clamp(22px, 2.34375vw, 44px);
  }

  .dot {
    width: 8px;
    height: 8px;
    border-radius: 50%;
    flex: none;
  }
  .dot-accent {
    background: var(--jv-accent);
  }
  .dot-rust {
    background: var(--jv-rust);
  }
  .dot-rust-dim {
    background: var(--jv-rust-dim);
  }
  .dot-accent-dim {
    background: var(--jv-accent-dim);
  }

  .back {
    color: inherit;
    text-decoration: none;
    opacity: 0.75;
  }

  .back:hover {
    opacity: 1;
  }

  .sep {
    opacity: 0.4;
  }

  h1 {
    font-size: var(--fs-h1-page);
    line-height: 1.05;
    letter-spacing: -0.03em;
    margin: 0 0 clamp(18px, 1.875vw, 36px);
    max-width: clamp(560px, 68.75vw, 1180px); /* 880px @ 1280 */
    text-wrap: balance;
  }

  .lede {
    font-size: var(--fs-2xl);
    line-height: 1.6;
    opacity: 0.7;
    max-width: clamp(400px, 42.96875vw, 760px); /* 550px @ 1280 */
  }

  /* The fact row sits on a rule, like the credentials band on the homepage. */
  .facts {
    display: flex;
    flex-wrap: wrap;
    gap: clamp(28px, 3.75vw, 72px);
    margin: clamp(32px, 3.4375vw, 66px) 0 0;
    padding-top: clamp(20px, 1.875vw, 36px);
    border-top: 1px solid var(--jv-divider);
  }

  .facts dt {
    font-size: var(--fs-xs);
    letter-spacing: 0.14em;
    text-transform: uppercase;
    opacity: 0.45;
    margin-bottom: 6px;
  }

  .facts dd {
    font-size: var(--fs-lg);
    margin: 0;
  }

  /* ── Phases ─────────────────────────────────────────────────────────────── */
  .phases {
    padding: 0 var(--gutter) clamp(64px, 6.5625vw, 126px);
  }

  /* Same hairline grid as the homepage method band: a 1px gap over a
     divider-coloured ground, with each cell repainting the page ground. */
  .steps {
    display: grid;
    grid-template-columns: repeat(4, 1fr);
    gap: 1px;
    background: var(--jv-divider);
    list-style: none;
    margin: 0;
    padding: 0;
    border-top: 1px solid var(--jv-divider);
    border-bottom: 1px solid var(--jv-divider);
  }

  .step {
    background: var(--jv-bg);
    padding: clamp(22px, 2.03125vw, 40px) clamp(20px, 1.875vw, 36px) clamp(24px, 2.34375vw, 46px);
  }

  .num {
    font-size: var(--fs-xs);
    font-family: var(--font-mono);
    color: var(--jv-accent);
    margin-bottom: clamp(12px, 1.09375vw, 20px);
  }

  .step h2 {
    font-size: var(--fs-2xl);
    line-height: 1.55;
    letter-spacing: normal;
    margin-bottom: 7px;
  }

  .step .body {
    font-size: var(--fs-md);
    opacity: 0.62;
    line-height: 1.5;
  }

  /* ── Detail bands ───────────────────────────────────────────────────────── */
  .detail {
    display: grid;
    grid-template-columns: clamp(240px, 23.4375vw, 440px) 1fr; /* 300px @ 1280 */
    gap: clamp(40px, 4.375vw, 88px); /* 56px @ 1280 */
    align-items: start;
    padding: clamp(48px, 5vw, 96px) var(--gutter);
    border-top: 1px solid var(--jv-divider);
  }

  .detail-head .kicker {
    margin-bottom: 14px;
  }

  .detail h2 {
    font-size: var(--fs-h3);
    letter-spacing: -0.02em;
    text-wrap: balance;
  }

  .prose {
    display: flex;
    flex-direction: column;
    gap: clamp(14px, 1.25vw, 24px);
    max-width: clamp(480px, 54.6875vw, 940px); /* 700px @ 1280 */
  }

  .prose p {
    font-size: var(--fs-lg);
    line-height: 1.65;
    opacity: 0.72;
  }

  /* ── Deliverables ───────────────────────────────────────────────────────── */
  .deliverables {
    padding: clamp(64px, 6.875vw, 132px) var(--gutter) clamp(56px, 5.9375vw, 116px);
    border-top: 1px solid var(--jv-divider);
  }

  .deliverables .layout {
    display: grid;
    grid-template-columns: clamp(240px, 23.4375vw, 440px) 1fr;
    gap: clamp(40px, 4.375vw, 88px);
    align-items: start;
  }

  .deliverables h2 {
    font-size: var(--fs-h2);
    letter-spacing: -0.02em;
    margin: 0 0 12px;
  }

  .deliverables .intro p {
    font-size: var(--fs-lg);
    opacity: 0.62;
  }

  .list {
    list-style: none;
    margin: 0;
    padding: 0;
  }

  .list .row {
    display: grid;
    grid-template-columns: clamp(180px, 17.1875vw, 320px) 1fr; /* 220px @ 1280 */
    gap: clamp(20px, 1.875vw, 36px);
    align-items: baseline;
    padding: clamp(18px, 1.71875vw, 34px) 0;
    border-top: 1px solid var(--jv-divider);
  }

  .list .row:last-child {
    border-bottom: 1px solid var(--jv-divider);
  }

  .list .title {
    font-family: var(--font-heading);
    font-weight: var(--font-heading-weight);
    font-size: var(--fs-xl);
  }

  .list .desc {
    font-size: var(--fs-md);
    opacity: 0.6;
    line-height: 1.5;
  }

  /* ── Other lines ────────────────────────────────────────────────────────── */
  .others {
    padding: clamp(40px, 4.0625vw, 78px) var(--gutter) clamp(44px, 4.375vw, 84px);
    border-top: 1px solid var(--jv-divider);
  }

  .others > .kicker {
    margin-bottom: clamp(16px, 1.5625vw, 30px);
  }

  .others ul {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 1px;
    background: var(--jv-divider);
    list-style: none;
    margin: 0;
    padding: 0;
    border-top: 1px solid var(--jv-divider);
    border-bottom: 1px solid var(--jv-divider);
  }

  .others a {
    display: flex;
    align-items: baseline;
    gap: 10px;
    flex-wrap: wrap;
    background: var(--jv-bg);
    padding: clamp(18px, 1.71875vw, 34px) clamp(20px, 1.875vw, 36px);
    color: inherit;
    text-decoration: none;
  }

  .others a:hover {
    background: var(--jv-ink-hover);
  }

  .others .moon {
    font-family: var(--font-heading);
    font-weight: var(--font-heading-weight);
    font-size: var(--fs-xl);
  }

  .others .title {
    font-size: var(--fs-md);
    opacity: 0.55;
    flex-basis: 100%;
  }

  /* ── Un-designed fallback — see global.css ──────────────────────────────── */
  @media (max-width: 1023px) {
    .steps {
      grid-template-columns: repeat(2, 1fr);
    }

    .detail,
    .deliverables .layout {
      grid-template-columns: 1fr;
      gap: clamp(20px, 2.5vw, 32px);
    }

    .others ul {
      grid-template-columns: 1fr;
    }
  }

  @media (max-width: 639px) {
    .steps {
      grid-template-columns: 1fr;
    }

    .list .row {
      grid-template-columns: 1fr;
      gap: 8px;
    }

    .facts {
      gap: 20px 28px;
    }
  }
</style>
